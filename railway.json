{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.watchtower",
    "watchPatterns": ["/watchtower/**", "/lib/policy/file.ts", "/Dockerfile.watchtower", "/package.json", "/railway.json"]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS"
  }
}
