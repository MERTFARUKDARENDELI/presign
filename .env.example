
# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# Helius: primary RPC + DAS (token metadata, NFTs, cNFTs). Without it, the app
# falls back to public RPC for basic data and reports enhanced data as unavailable.
HELIUS_API_KEY=
# Optional. The RugCheck report endpoints used here are public; kept for future authenticated use.
RUGCHECK_API_KEY=
# Optional. Anthropic API key (console.anthropic.com, starts with sk-ant-) for plain-language
# explanations. Without it AI is off and the deterministic reports are shown unchanged.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-5-5)
AI_MODEL=
# Optional backup for the pre-sign explanations only: a Google Gemini API key (aistudio.google.com).
# Claude is asked first every time; Gemini answers only when Claude cannot (no key, credit or rate limit,
# outage), under the same rules and checks. Free-tier requests may be used by Google to improve its products.
GEMINI_API_KEY=
# Optional backup model override (default: gemini-3.5-flash-lite)
GEMINI_MODEL=

# REQUIRED in production (>= 32 random characters, e.g. `openssl rand -base64 48`). Seals the session-bound
# tokens of Secure Connect and the pre-sign review; without it those features refuse to run in production
# (/api/health reports presignSessionSecret). Development falls back to a derived or per-process key.
PRESIGN_SESSION_SECRET=
# Optional, during a rotation: the previous secret, so tokens issued in the last minutes keep opening.
PRESIGN_SESSION_SECRET_PREVIOUS=

# Optional shared store (Upstash Redis REST; Vercel KV sets KV_REST_API_URL / KV_REST_API_TOKEN instead).
# With it, single use (nonces, approvals, submissions) and rate limits hold across every server instance;
# without it, or if it does not answer, they are per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. The one public origin of this deployment, e.g. https://presign-app.vercel.app. When set it is the
# domain in ownership messages, and pages requested on any other host (an old domain, an alias) get a permanent
# redirect to it. Set it on the Production environment only (preview URLs would otherwise redirect too).
PRESIGN_CANONICAL_ORIGIN=
# Off Vercel: how many proxies in front of the app append to X-Forwarded-For (1-5). Without it, X-Forwarded-*
# headers are treated as client-controlled: ignored for the host, and all clients share one rate-limit bucket.
PRESIGN_TRUSTED_PROXY_HOPS=

# Optional. Slack- or Discord-compatible incoming webhook (https) for operator alerts: every error and a few
# outages (RPC / upstream 5xx, shared store down, an AI explanation that contradicted the verdict), at most once
# per event per 10 minutes per instance. Carries event, route, code and a redacted message, never request data.
PRESIGN_ALERT_WEBHOOK_URL=

# --- Network ---
# mainnet-beta (default) or devnet. Test cleanup (burn/close/revoke) on devnet first.
SOLANA_CLUSTER=mainnet-beta
# Must match SOLANA_CLUSTER; only used for mobile wallet cluster detection in the browser.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# Optional secondary RPC used when Helius fails (standard JSON-RPC methods only, never DAS).
SOLANA_FALLBACK_RPC_URL=
# Set to "true" to disable the public RPC fallback entirely.
SOLANA_DISABLE_PUBLIC_FALLBACK=false
# Set to "true" to skip RugCheck (analysis is then reported as PARTIAL).
RUGCHECK_DISABLED=false
# Presign Guard program id on this cluster (guard/Anchor.toml). Empty = Guard features off.
# It is deployed only where you deploy it (devnet for the demo); leave empty on mainnet.
NEXT_PUBLIC_GUARD_PROGRAM_ID=

# --- Watchtower (separate process: npm run watchtower) ---
# Multisigs to watch (comma-separated) and the Presign instance to ask.
WATCH_MULTISIGS=
PRESIGN_API_URL=http://localhost:3000
# Base URL used in alert links (defaults to PRESIGN_API_URL).
PRESIGN_PUBLIC_URL=
POLL_SECONDS=30
# Telegram delivery: create a bot with @BotFather, add it to the signers' group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Slack or Discord incoming webhook (optional, alongside or instead of Telegram).
ALERT_WEBHOOK_URL=
# Set to "true" to alert proposals that are already pending when Watchtower first starts.
ALERT_EXISTING=false

# Team policy JSON checked on every proposal (one policy, or an array keyed by "multisig"). See /docs#policy.
PRESIGN_POLICY_FILE=

# --- MCP server for AI agents (npm run mcp) uses PRESIGN_API_URL and PRESIGN_POLICY_FILE. ---
