
# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# Helius: primary RPC + DAS (token metadata, NFTs, cNFTs). Without it, the app
# falls back to public RPC for basic data and reports enhanced data as unavailable.
HELIUS_API_KEY=
# Optional. The RugCheck report endpoints used here are public; kept for future authenticated use.
RUGCHECK_API_KEY=
# Optional. Without it the AI agent is disabled and deterministic reports are shown.
OPENAI_API_KEY=
# Optional model override (default: gpt-4.1-mini)
OPENAI_MODEL=

# --- Network ---
# mainnet-beta (default) or devnet. Test cleanup (burn/close/revoke) on devnet first.
SOLANA_CLUSTER=mainnet-beta
# Must match SOLANA_CLUSTER; only used for mobile wallet cluster detection in the browser.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# Optional secondary RPC used when Helius fails (standard JSON-RPC methods only, never DAS).
SOLANA_FALLBACK_RPC_URL=
# Set to "true" to disable the public RPC fallback entirely.
SOLANA_DISABLE_PUBLIC_FALLBACK=false
# Set to "true" to skip RugCheck (analysis is then reported as PARTIAL).
RUGCHECK_DISABLED=false
# Presign Guard program id on this cluster (guard/Anchor.toml). Empty = Guard features off.
# It is deployed only where you deploy it (devnet for the demo); leave empty on mainnet.
NEXT_PUBLIC_GUARD_PROGRAM_ID=

# --- Watchtower (separate process: npm run watchtower) ---
# Multisigs to watch (comma-separated) and the Presign instance to ask.
WATCH_MULTISIGS=
PRESIGN_API_URL=http://localhost:3000
# Base URL used in alert links (defaults to PRESIGN_API_URL).
PRESIGN_PUBLIC_URL=
POLL_SECONDS=30
# Telegram delivery: create a bot with @BotFather, add it to the signers' group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Slack or Discord incoming webhook (optional, alongside or instead of Telegram).
ALERT_WEBHOOK_URL=
# Set to "true" to alert proposals that are already pending when Watchtower first starts.
ALERT_EXISTING=false

# Team policy JSON checked on every proposal (one policy, or an array keyed by "multisig"). See /docs#policy.
PRESIGN_POLICY_FILE=

# --- MCP server for AI agents (npm run mcp) uses PRESIGN_API_URL and PRESIGN_POLICY_FILE. ---
