{
  "manifest_version": 3,
  "name": "Presign — Know exactly what you sign",
  "short_name": "Presign",
  "version": "0.1.0",
  "description": "Reviews Solana wallet signing requests before your wallet opens: decode, simulate, deterministic risk rules, evidence. You decide.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Presign",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://presign-app.vercel.app/*", "https://presign-devnet.vercel.app/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ],
  "externally_connectable": {
    "matches": ["https://presign-app.vercel.app/*", "https://presign-devnet.vercel.app/*"]
  }
}
